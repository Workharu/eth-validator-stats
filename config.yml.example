# Copy to $XDG_CONFIG_HOME/eth-validator-stats/config.yml
# (typically ~/.config/eth-validator-stats/config.yml)
# Or let `eth-validator-stats init` create it for you.

# Beacon node base URL: scheme + host + port only, NO API path.
# Right: http://localhost:3500
# Wrong: http://localhost:3500/eth/v1/beacon/headers/head
# Env var BEACON_NODE_URL overrides this.
# Default ports by client: Prysm 3500, Lighthouse 5052, Teku 5051,
# Nimbus 5052, Lodestar 9596. See COMPATIBILITY.md.
beacon_node_url: http://localhost:3500

# Optional Bearer token (Infura/Alchemy/QuickNode, or any proxied node).
# Env BEACON_NODE_AUTH_TOKEN wins over this.
# beacon_auth_token: your-bearer-token-here

# One entry per validator. Identify by pubkey OR index. Label is optional.
validators:
  - pubkey: "0xb1d2a4b9c5b4f1e6a8b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0"
    label: home-1
  - index: 12345
    label: home-2

# Optional. If `ntfy_topic` is missing or blank, no push notifications fire;
# `check` still prints offenders and exits 2 for cron use.
alerts:
  ntfy_topic: https://ntfy.sh/eth-vstats-replace-with-random-secret
  cooldown_minutes: 30
  storm_threshold: 10

  # Notify after this many consecutive missed attestations.
  # CLI flag `--missed N` overrides this at invocation time.
  missed_attestations_threshold: 2

  # Ignore withdrawals smaller than this many gwei (0.001 ETH default).
  # Prevents dust from triggering alerts; real withdrawals are normally >>this.
  withdrawal_threshold_gwei: 1000000

  # Skip withdrawal detection if the two compared balance snapshots are this many
  # slots apart or more. Default 64 slots ≈ 12.8 min on mainnet — wider gaps make
  # it impossible to tell a real withdrawal apart from cumulative attestation
  # losses during a `check` outage. Raise if you run `check` very infrequently.
  withdrawal_max_gap_slots: 64

  # How far ahead to pre-notify about an upcoming block proposal.
  # 1 epoch ≈ 6.4 min on mainnet. Set to 0 to disable upcoming-proposal alerts.
  proposal_lookahead_epochs: 1

  # Icon shown next to each ntfy push on the phone. Leave the default to
  # use the eth-validator-stats logo (served from this project's repo).
  # Set to "" to suppress the icon. Set to your own publicly-fetchable
  # URL to brand pushes differently.
  # icon_url: ""
